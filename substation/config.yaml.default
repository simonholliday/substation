# Substation configuration, with every setting at its default value.
#
# `substation --init` copies this file to start a config.yaml.  A setting
# removed from config.yaml falls back to the value shown here.
#
# Substation generates this file from substation/config.py and
# substation/band_library.yaml, with:
#
#     python -m substation.generate_default_config

# Scanner settings, applying to every band.
#
# These settings control how the scanner reads IQ samples from the SDR, how it
# buffers them, and whether it calibrates the receiver's frequency at startup.
scanner:

    # Size, in IQ samples, of the blocks each slice is built from. The scanner
    # rounds every slice up to a whole number of these blocks, so this also
    # sets the shortest possible slice. On an RTL-SDR it must be a multiple of
    # 256, for example 65536.
    sdr_device_sample_size: 131072

    # How often the scanner analyses the spectrum, in milliseconds. The scanner
    # reads, queues, and processes IQ samples one slice at a time, and rounds
    # each slice up to a whole number of `sdr_device_sample_size` blocks, so at
    # low sample rates a slice can be longer than this. Shorter slices detect
    # brief transmissions sooner; longer slices use less CPU and more memory.
    band_time_slice_ms: 200

    # Number of slices of IQ samples the scanner holds while processing catches
    # up. When the queue is full, the scanner drops newly arriving slices with
    # a warning and keeps the slices already queued. A larger queue tolerates
    # longer processing spikes, such as several radio channels activating at
    # once. Each queued slice holds every IQ sample in it, so at high sample
    # rates a full queue can need more memory than a small computer has: lower
    # it there.
    sample_queue_maxsize: 200

    # Frequency in Hz of a strong, steady local signal that the scanner uses at
    # startup to measure and correct the receiver's frequency error. Null, the
    # default, leaves the receiver's correction as it is. An FM broadcast
    # station is the usual choice, because it is on air all day at a fixed
    # frequency: in parts of the UK, 93.7e+6 is BBC Radio 4. Pick a station you
    # receive well, since the scanner skips calibration with a warning, and
    # leaves the correction unchanged, when it finds no strong, steady signal
    # there. Only RTL-SDR receivers have a PPM correction control; other
    # devices skip calibration.
    calibration_frequency_hz: null

    # Time in seconds after which the scanner warns that a radio channel has
    # stayed active, which usually points to interference or a stuck
    # transmitter. The scanner repeats the warning at most once a minute and
    # keeps detecting and recording. Recommended: 30-120 seconds. Set to null
    # to turn the warning off.
    stuck_channel_threshold_seconds: 60

# Recording settings, applying to every band that records.
#
# These settings control how the scanner buffers, processes, and saves the
# audio it demodulates.
recording:

    # Most audio, in seconds, the scanner holds in memory for each radio
    # channel before writing it to disk. If disk writes fall behind, the
    # scanner drops the oldest audio. A larger buffer tolerates slower disks
    # and uses more memory.
    buffer_size_seconds: 30

    # How often the scanner writes buffered audio to disk, in seconds. Shorter
    # intervals hold less audio in memory and cost more disk activity.
    disk_flush_interval_seconds: 5

    # Sample rate of the recorded audio, in Hz. 16 kHz covers the voice band;
    # higher rates keep more high-frequency content and use more disk space.
    audio_sample_rate: 16000

    # File format for recordings. WAV is uncompressed and embeds Broadcast WAV
    # (BEXT) metadata with the time each recording starts, so audio editors
    # such as Audacity, Reaper, and iZotope RX place each recording on a
    # timeline at its real capture time. FLAC is lossless and smaller than WAV,
    # by an amount that depends on the band and the signal, but cannot carry
    # BEXT timeline metadata: the date, time, and frequency are stored as text
    # tags.
    audio_format: wav

    # Directory where the scanner saves recordings, in a folder for each date
    # and then each band: `<audio_output_dir>/YYYY-MM-DD/<band>/`.
    audio_output_dir: ./audio

    # Length of the fade-in at the start of each recording, in milliseconds,
    # which prevents a click from a sudden onset. Set to 0 or null for no fade.
    fade_in_ms: 15

    # Length of the fade-out at the end of each recording, in milliseconds,
    # which prevents a click from a sudden cutoff. Set to 0 or null for no
    # fade.
    fade_out_ms: 50

    # Drive of the soft limiter that keeps recordings from clipping. Higher
    # values compress loud signals more strongly; lower values leave more of
    # the dynamic range untouched.
    soft_limit_drive: 1.25

    # Whether the scanner applies spectral-subtraction noise reduction to
    # recorded audio. Set to false to record the demodulated audio without it.
    noise_reduction_enabled: true

    # Time in milliseconds the scanner keeps recording after a radio channel's
    # signal drops below its off threshold.
    recording_hold_time_ms: 500

    # Whether the scanner discards noise-only recordings, using spectral
    # flatness analysis. It rejects noise triggers before a recording starts,
    # and discards files that turn out to be mostly noise when they close.
    discard_empty_enabled: true

    # Shortest recording the scanner keeps, in seconds. It deletes shorter
    # recordings when they close, which catches brief transients, such as radar
    # pulses and ignition noise, that pass the spectral checks. Set to 0 to
    # keep every recording.
    min_recording_seconds: 0.5

    # Audio silence timeout in milliseconds. Stops recording when demodulated
    # audio has been silent for this long, even if the RF carrier is still
    # present (common on AM airband where the carrier persists after voice
    # stops). Set to 0 to rely on RF-only detection.
    audio_silence_timeout_ms: 3000

    # Whether the scanner removes the sharp clicks a transmitter makes at
    # key-on and key-off. It trims only transients bordered by silence, so
    # voice is never affected. Recommended for AM airband listening.
    trim_carrier_transients: false

    # Whether the scanner applies the experimental dynamics curve, set by
    # `dynamics_curve`, to recorded audio.
    dynamics_curve_enabled: false

    # Settings for the experimental dynamics curve. The scanner uses them only
    # when `dynamics_curve_enabled` is true.
    dynamics_curve:

        # Level in dBFS that divides the cut region from the boost region.
        # Typical values: -20 to -35 dBFS.
        threshold_dbfs: -25

        # Gain reduction in dB at the midpoint of the cut S-curve. The largest
        # reduction, at `floor_dbfs`, is twice this value. Set to 0 to turn the
        # cut region off.
        cut_db: 6

        # Largest gain boost in dB, at the peak of the boost hump. Set to 0 to
        # turn the boost region off.
        boost_db: 1.5

        # Level in dBFS below which the output is silenced. Must be below
        # `threshold_dbfs`.
        floor_dbfs: -60

        # Where the cut S-curve is steepest. 0.5 is symmetric; lower values
        # move the steepest part towards `threshold_dbfs`, and higher values
        # towards `floor_dbfs`. Below about 0.33 the curve no longer meets
        # `threshold_dbfs` smoothly: the cut begins with a sharp kink there,
        # which becomes a step of several dB near 0.
        cut_curve: 0.5

        # Skew of the boost hump, on the same scale as `cut_curve`. 0.5 is
        # symmetric. Near 1 the hump falls steeply just below full scale, and
        # with a `boost_db` of a few dB a louder input there comes out quieter.
        boost_curve: 0.5

# Band settings
#
# `band_defaults` holds templates of settings, and `bands` holds the bands to
# scan; the band library that follows fills both.  The settings each template,
# band, and device override accepts are listed first, each with its default.
#
# Settings for each template in `band_defaults`
#
# A template of settings shared by one type of radio service, such as DMR,
# TETRA, or PMR.
#
# A band names its template in `type` and inherits the settings the template
# gives, such as the radio channel spacing and modulation that every DMR band
# shares. A band overrides an inherited setting by giving it itself. Every
# setting in a template is optional, and a template passes on none that it
# leaves out or sets to null. Each band must still end up with the settings a
# band requires.
#
#   channel_spacing: null
#     Spacing between radio channel centre frequencies, in Hz, for example
#     12.5 kHz for PMR and DMR, or 25 kHz for marine VHF.
#
#   sample_rate: null
#     SDR sample rate in Hz. Must be high enough to cover the whole band plus
#     margins, for example 2 MHz for the 188 kHz PMR446 band.
#
#   channel_width: null
#     Occupied bandwidth of each radio channel, in Hz. When null, the scanner
#     uses 84% of `channel_spacing`, which leaves guard bands between radio
#     channels.
#
#   modulation: null
#     Modulation the scanner demodulates for recording: `NFM`, `AM`, `USB`, or
#     `LSB`, in any letter case.
#
#   recording_enabled: false
#     Whether the scanner records audio from detected transmissions. Set to
#     false for detection only, with no audio files.
#
#   snr_threshold_db: null
#     Signal-to-noise ratio in dB at which a radio channel counts as active.
#     Lower values detect weaker signals and trigger more often on noise.
#
#   sdr_gain_db: auto
#     SDR gain in dB, or `auto` for automatic gain control. Higher gain is more
#     sensitive, and also amplifies noise and can cause clipping.
#
# Settings for each band in `bands`
#
# One band to scan.
#
# A band sets a frequency range, the spacing of its radio channels, and how the
# scanner treats them. The scanner monitors every radio channel in the band at
# once.
#
#   freq_start: (required)
#     Start of the band's frequency range in Hz, for example 446.00625 MHz for
#     PMR446.
#
#   freq_end: (required)
#     End of the band's frequency range in Hz, for example 446.19375 MHz for
#     PMR446. Must be above `freq_start`.
#
#   channel_spacing: (required)
#     Spacing between radio channel centre frequencies, in Hz, for example
#     12.5 kHz. The scanner places radio channels from `freq_start` to
#     `freq_end` at this spacing.
#
#   sample_rate: (required)
#     SDR sample rate in Hz. Must be high enough to cover the band's span plus
#     one radio channel's width and margins, for example 2 MHz for PMR446.
#
#   channel_width: null
#     Occupied bandwidth of each radio channel, in Hz. When null, the scanner
#     uses 84% of `channel_spacing`, which leaves 16% as guard bands.
#
#   type: null
#     Name of a template in `band_defaults`, such as `DMR` or `TETRA`, whose
#     settings the band inherits.
#
#   modulation: null
#     Modulation the scanner demodulates: `NFM`, `AM`, `USB`, or `LSB`, in any
#     letter case. Recording needs one; without it, the scanner only detects
#     activity in the band.
#
#   recording_enabled: false
#     Whether the scanner records audio from active radio channels. Set to
#     false for detection only, with no audio files.
#
#   exclude_channel_indices: []
#     Radio channel numbers the scanner skips, counting from 1, as shown in log
#     output and filenames. Use it for known interference or out-of-band radio
#     channels: `[1, 2]` skips the first two.
#
#   snr_threshold_db: 12
#     Signal-to-noise ratio in dB at which a radio channel turns on. Lower
#     values, such as 8-10 dB, detect weaker signals and trigger more often on
#     noise.
#
#   hysteresis_db: 3
#     Margin in dB between the on and off thresholds. A radio channel turns on
#     when its SNR rises above `snr_threshold_db`, and off when it falls below
#     `snr_threshold_db` minus this margin, which stops it toggling while the
#     SNR hovers near the threshold. Use a lower value, such as 1.5 dB, when
#     scanning weak signals with a low `snr_threshold_db`.
#
#   sdr_gain_db: auto
#     SDR gain in dB, or `auto` for automatic gain control. `auto` is
#     convenient, but a manual gain, for example 20-40 dB on RTL-SDR, often
#     works better.
#
#   sdr_gain_elements: null
#     Gain in dB for each gain stage, on devices with several, keyed by stage
#     name: the AirSpy R2, for example, has `LNA`, `MIX`, and `VGA`. Stage
#     names depend on the device, and the scanner logs the available stages and
#     their ranges at startup. When set, it takes priority over `sdr_gain_db`.
#     Example: {LNA: 10, MIX: 5, VGA: 12}
#
#   sdr_device_settings: null
#     Device-specific settings the scanner passes to the SDR through SoapySDR's
#     `writeSetting()`, such as bias tee control, an external clock, or device
#     calibration. Keys and values are device-specific strings.
#     Example: {biastee: "true"}
#
#   activation_variance_db: null
#     Power variance in dB, across a detection slice, that a radio channel must
#     show to turn on. It suppresses triggers from stationary noise that
#     crosses the SNR threshold with no real signal: voice and data vary by
#     5-15 dB or more over a slice, and stationary noise by under 2 dB. It
#     applies whether or not the band records. When null, the scanner uses
#     `substation.constants.ACTIVATION_VARIANCE_DB`. Set to 0 to turn the check
#     off.
#
#   device_overrides: null
#     Settings that replace this band's own on one family of SDR device, keyed
#     by family: `rtlsdr`, `hackrf`, `airspy`, `airspyhf`, or a SoapySDR driver
#     name. A key can use any `--device-type` spelling of its family, in any
#     letter case. When the scanner runs with a matching `--device-type`, it
#     merges those settings onto the band's. A key that names no family the
#     scanner knows logs a warning, unless it is written as `soapy:` followed
#     by a SoapySDR driver name.
#     Example: {airspy: {sample_rate: 2.5e+6, sdr_gain_elements: {LNA: 14, MIX: 5, VGA: 12}}}
#
# Settings for each device family in a band's `device_overrides`
#
# Settings that replace a band's own when the scanner runs on one family of SDR
# device.
#
# Every setting is optional. Only the settings given here replace the band's,
# and only when the device selected with `--device-type` is in that family.
#
#   sample_rate: null
#     SDR sample rate in Hz on this device. Must cover the band's span.
#
#   sdr_gain_db: null
#     SDR gain in dB on this device, or `auto` for automatic gain control.
#
#   sdr_gain_elements: null
#     Gain in dB for each of this device's gain stages, keyed by stage name,
#     for example `LNA`, `MIX`, and `VGA`.
#     Example: {LNA: 10, MIX: 5, VGA: 12}
#
#   sdr_device_settings: null
#     Device-specific settings on this device, such as bias tee control, as
#     string keys and values.
#     Example: {biastee: "true"}
#
#   snr_threshold_db: null
#     Signal-to-noise ratio in dB at which a radio channel counts as active on
#     this device.
#
#   activation_variance_db: null
#     Power variance in dB that a radio channel must show to count as active on
#     this device. Set to 0 to turn the check off.

# Band library: the templates and bands shipped with Substation.
#
# Hand-written, and included as it is at the end of config.yaml.default by
# `python -m substation.generate_default_config`, after the settings that
# script generates from substation/config.py.  Edit the bands here, then run
# the script.

band_defaults:

    # Generic narrow-FM voice bands (UHF business radio, amateur 2m,
    # marine VHF, fire ground, etc.).  Each band sets its own
    # channel_spacing because conventions differ between services.
    NFM:
        modulation: NFM
        recording_enabled: false

    # Default settings for PMR bands
    PMR:
        channel_spacing: 12.5e+3
        modulation: NFM
        recording_enabled: true
        snr_threshold_db: 4.5
        sdr_gain_db: 36

    # Default settings for DMR bands
    DMR:
        channel_spacing: 12.5e+3
        modulation: NFM
        snr_threshold_db: 15
        sdr_gain_db: 24

    # Default settings for airband voice (AM)
    AIR:
        channel_spacing: !fraction 25000/3
        modulation: AM
        recording_enabled: true
        snr_threshold_db: 4.5
        sdr_gain_db: 30

    # TETRA: detection only, with no demodulator.
    # Bands using this type detect radio channel activity but cannot record audio.
    # The uplink frequency for a given radio channel sits 10 MHz below the paired
    # downlink frequency.
    TETRA:
        channel_spacing: 25.0e+3
        modulation: TETRA
        snr_threshold_db: 3.5
        sdr_gain_db: 36

    # HF / shortwave on AirSpy HF+ Discovery.
    # Each HF band sets its own modulation (USB / LSB / AM) explicitly,
    # because the right choice depends on the band's content:
    #   - 80m, 40m  → LSB by amateur convention (below 10 MHz)
    #   - 20m, 17m, 15m, 12m, 10m, HFGCS, VOLMET → USB (above 10 MHz)
    #   - International broadcast and pirate radio → AM
    # Radio channel spacing of 5 kHz comfortably contains a single ~2.7 kHz
    # SSB transmission per radio channel.
    HF:
        channel_spacing: 5.0e+3
        recording_enabled: true
        snr_threshold_db: 6
        sdr_gain_db: auto

    # Citizens Band 27 MHz - NFM voice, 10 kHz spacing.
    CB:
        channel_spacing: 10.0e+3
        modulation: NFM
        recording_enabled: true
        snr_threshold_db: 4.5
        sdr_gain_db: 36

    # Digital data bands (ACARS, VDL Mode 2, etc.).  Detection only -
    # there is no demodulator for these protocols, so recording is
    # disabled by default.
    DATA:
        recording_enabled: false

bands:

    # Practical maximum sample rates:
    # - RTL-SDR Blog V4: 2.4MHz
    # - HackRF One: 16MHz
    # - AirSpy R2: 10MHz
    # - AirSpy HF+ Discovery: 768kHz

    pmr:
        type: PMR
        freq_start: 446.00625e+6
        freq_end: 446.19375e+6
        sample_rate: 1.024e6
        exclude_channel_indices: [1, 2, 3]

    # Air

    air_civil_1:
        type: AIR
        freq_start: 118.0e+6
        freq_end: 127.5e+6
        sample_rate: 12.5e+6

    air_civil_2:
        type: AIR
        freq_start: 127.5e+6
        freq_end: 137.0e+6
        sample_rate: 12.5e+6

    # Specific Bristol/Local Area (Faster scanning)

    air_civil_bristol:
        type: AIR
        freq_start: 125.5e+6
        freq_end: 126.0e+6
        sample_rate: 1.024e6
        exclude_channel_indices: [26, 27, 34, 35]
        device_overrides:
            # AirSpy HF+ Discovery - sensitive narrow-band receiver.
            # The HF+ is sensitive enough that the standard SNR threshold
            # catches stationary noise as well as real signals;
            # activation_variance_db filters out those noise triggers.
            airspyhf:
                sample_rate: 0.912e6
                snr_threshold_db: 6
                sdr_gain_db: auto
                activation_variance_db: 3.0

    # UK Military Airband
    # This is the whole allocation, which is far wider than any receiver can
    # hear at once: scanning it needs a copy narrowed to the part you want.
    air_military_uhf:
        type: AIR
        freq_start: 225.0e+6
        freq_end: 400.0e+6
        channel_spacing: 25.0e+3
        sample_rate: 2.4e+6
        sdr_gain_db: 36

    # ACARS Digital Data (Standard)
    air_acars_primary:
        type: DATA
        freq_start: 131.5e+6
        freq_end: 131.9e+6
        channel_spacing: 25.0e+3
        sample_rate: 1.0e+6
        modulation: AM
        snr_threshold_db: 15
        sdr_gain_db: 36

    # VDL Mode 2 (High-speed Digital Aviation Data)
    air_vdl_m2:
        type: DATA
        freq_start: 136.9e+6
        freq_end: 136.975e+6
        channel_spacing: 25.0e+3
        sample_rate: 1.0e+6
        modulation: AM
        snr_threshold_db: 15
        sdr_gain_db: 36

    # Fire Ground Simplex (analogue - used at scene of incidents)
    fire_ground_uhf:
        type: NFM
        freq_start: 457.0e+6
        freq_end: 457.5e+6
        channel_spacing: 12.5e+3
        sample_rate: 1.0e+6
        modulation: NFM
        snr_threshold_db: 15
        sdr_gain_db: 24

    # Amateur Radio 2m Band (UK)
    amateur_2m:
        type: NFM
        freq_start: 144.0e+6
        freq_end: 146.0e+6
        channel_spacing: 12.5e+3
        sample_rate: 2.4e+6
        modulation: NFM
        snr_threshold_db: 4.5
        sdr_gain_db: 36

    # Marine VHF (focus on the international calling radio channel, 16)
    marine_vhf_calling:
        type: NFM
        freq_start: 156.0e+6
        freq_end: 157.4e+6
        channel_spacing: 25.0e+3  # Marine can be 12.5 or 25, 25 is common for older gear
        sample_rate: 2.4e+6
        modulation: NFM
        snr_threshold_db: 5.0
        sdr_gain_db: 30

    # UK Simple Business Radio (UHF)
    business_simple_uk_uhf:
        type: NFM
        freq_start: 449.3e+6
        freq_end: 449.5e+6
        channel_spacing: 12.5e+3
        sample_rate: 1.024e+6
        modulation: NFM
        snr_threshold_db: 6.0
        sdr_gain_db: 36

    # -----------------------------------------------------------------
    # DMR (UK)
    # -----------------------------------------------------------------

    # All UK DMR - requires high-bandwidth device (e.g. HackRF)
    dmr:
        type: DMR
        freq_start: 452.5e+6
        freq_end: 460.5e+6
        sample_rate: 12.5e+6

    # DMR slices for RTL-SDR (2.4 MHz bandwidth limit)
    dmr_1:
        type: DMR
        freq_start: 452.5e+6
        freq_end: 454.5e+6
        sample_rate: 2.4e+6

    dmr_2:
        type: DMR
        freq_start: 457.5e+6
        freq_end: 459.5e+6
        sample_rate: 2.4e+6

    dmr_3:
        type: DMR
        freq_start: 458.5e+6
        freq_end: 460.5e+6
        sample_rate: 2.4e+6

    dmr_4:
        type: DMR
        freq_start: 453.0e+6
        freq_end: 453.3e+6
        sample_rate: 2.4e+6

    dmr_5:
        type: DMR
        freq_start: 455.0e+6
        freq_end: 457.0e+6
        sample_rate: 2.4e+6

    # -----------------------------------------------------------------
    # TETRA / Airwave (UK)
    # -----------------------------------------------------------------

    # Airwave Downlink (always-on)

    tetra_airwave_downlink:
        type: TETRA
        freq_start: 390.0e+6
        freq_end: 395.0e+6
        sample_rate: 10.0e+6

    tetra_airwave_downlink_1:
        type: TETRA
        freq_start: 390.0e+6
        freq_end: 391.9e+6
        sample_rate: 2.4e+6

    tetra_airwave_downlink_2:
        type: TETRA
        freq_start: 391.5e+6
        freq_end: 393.4e+6
        sample_rate: 2.4e+6

    tetra_airwave_downlink_3:
        type: TETRA
        freq_start: 393.1e+6
        freq_end: 395.0e+6
        sample_rate: 2.4e+6

    # Airwave Uplink

    tetra_airwave_uplink:
        type: TETRA
        freq_start: 380.0e+6
        freq_end: 385.0e+6
        sample_rate: 10.0e+6

    tetra_airwave_uplink_1:
        type: TETRA
        freq_start: 380.0e+6
        freq_end: 381.9e+6
        sample_rate: 2.4e+6

    tetra_airwave_uplink_2:
        type: TETRA
        freq_start: 381.5e+6
        freq_end: 383.4e+6
        sample_rate: 2.4e+6

    tetra_airwave_uplink_3:
        type: TETRA
        freq_start: 383.1e+6
        freq_end: 385.0e+6
        sample_rate: 2.4e+6

    # London-only Emergency Services Extensions
    # Wider than its own sample rate covers: scanning it needs a copy split
    # into parts, or a higher sample rate on a receiver that reaches one.

    tetra_london_extension:
        type: TETRA
        freq_start: 420.0e+6
        freq_end: 423.0e+6
        sample_rate: 2.4e+6

    # Commercial Downlink

    tetra_commercial_downlink:
        type: TETRA
        freq_start: 420.0e+6
        freq_end: 425.0e+6
        sample_rate: 10.0e+6

    tetra_commercial_downlink_1:
        type: TETRA
        freq_start: 420.0e+6
        freq_end: 421.9e+6
        sample_rate: 2.4e+6

    tetra_commercial_downlink_2:
        type: TETRA
        freq_start: 421.5e+6
        freq_end: 423.4e+6
        sample_rate: 2.4e+6

    tetra_commercial_downlink_3:
        type: TETRA
        freq_start: 423.1e+6
        freq_end: 425.0e+6
        sample_rate: 2.4e+6

    # Commercial Uplink

    tetra_commercial_uplink:
        type: TETRA
        freq_start: 410.0e+6
        freq_end: 420.0e+6
        sample_rate: 16.0e+6

    # Prison/Civil (450-462.4 MHz)

    tetra_prison_civil:
        type: TETRA
        freq_start: 450.0e+6
        freq_end: 462.4e+6
        sample_rate: 16.0e+6

    tetra_prison_civil_1:
        type: TETRA
        freq_start: 450.0e+6
        freq_end: 451.9e+6
        sample_rate: 2.4e+6

    tetra_prison_civil_2:
        type: TETRA
        freq_start: 451.5e+6
        freq_end: 453.4e+6
        sample_rate: 2.4e+6

